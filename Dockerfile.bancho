FROM oven/bun:1 AS build
WORKDIR /app

# Install workspace deps
COPY package.json bun.lock ./
COPY packages ./packages
COPY apps ./apps
RUN bun install --ignore-scripts

# Compile Bancho into a single binary
RUN bun build --compile apps/bancho/src/index.ts --outfile /app/bancho

# Runtime image: no node_modules needed
FROM debian:bookworm-slim AS runtime
WORKDIR /app
COPY --from=build /app/bancho /app/bancho
ENV NODE_ENV=production
EXPOSE 3000
CMD ["/app/bancho"]


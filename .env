# Database
DATABASE_URL="postgresql://admin:password@localhost:5432/mug"

# Redis
REDIS_URL="redis://localhost:6379"
UPLOAD_QUEUE_KEY="upload-jobs"
# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="admin"
S3_SECRET_ACCESS_KEY="password"
S3_BUCKET="mug"


# Websocket endpoint for Bancho
PUBLIC_WS_URL="ws://localhost:3000"

# better-auth signing key. Local development only: deployments must set a
# different value, otherwise sessions are signed with a published key.
# better-auth refuses to start in production without this, which also breaks
# `bun run build` because the SSR bundle evaluates the auth config.
BETTER_AUTH_SECRET="local-dev-only-secret-change-me-0123456789abcdef"

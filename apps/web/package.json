{
	"name": "@mug/web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"auth:generate": "bunx --bun @better-auth/cli generate --config ./src/lib/server/auth.ts --output ./src/lib/server/db/auth-schema.ts -y"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/bun": "^1.3.4",
		"svelte": "^5.45.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.7"
	},
	"dependencies": {
		"@libsql/client": "^0.15.15",
		"@mug/common": "workspace:*",
		"@mug/contract": "workspace:*",
		"@mug/db": "workspace:*",
		"@mug/engine": "workspace:*",
		"@mug/game-logic": "workspace:*",
		"@orpc/client": "^1.12.2",
		"@orpc/server": "^1.12.2",
		"@pixi/sound": "^6.0.1",
		"@types/uuid": "^11.0.0",
		"arktype": "^2.1.28",
		"better-auth": "^1.4.6",
		"drizzle-arktype": "^0.1.3",
		"drizzle-orm": "^0.45.1",
		"gsap": "^3.14.1",
		"jszip": "^3.10.1",
		"pixi.js": "^8.14.3",
		"svelte-adapter-bun": "^1.0.1",
		"tweakpane": "^4.0.5",
		"uuid": "^13.0.0"
	}
}

{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"rootDir": "../..",
		"outDir": "./dist",
		"lib": ["ES2020", "DOM"],
		"types": ["bun", "node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"paths": {
			"@mug/db": ["../../packages/db/src"],
			"@mug/db/*": ["../../packages/db/src/*"],
			"@mug/contract": ["../../packages/contract/src"],
			"@mug/contract/*": ["../../packages/contract/src/*"]
		}
	},
	"include": ["src/**/*"]
}

{
	"name": "mug",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev:services": "bunx concurrently \"bun run --cwd apps/bancho  dev\" \"bun run --cwd apps/processor dev\" \"bun run dev\"",
		"db:push": "bunx drizzle-kit push",
		"db:studio": "bunx drizzle-kit studio",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"docker:up": "docker compose up -d",
		"docker:up-no-frontend": "docker compose up -d db minio minio-init",
		"docker:down": "docker compose down",
		"docker:destroy": "docker compose down -v",
		"docker:rebuild": "docker compose down -v && docker compose up -d --build",
		"docker:restart-frontend": "docker compose -p mug restart frontend",
		"auth:generate": "bunx --bun  @better-auth/cli generate  --config ./src/lib/server/auth.ts  --output ./src/lib/server/db/auth-schema.ts -y",
		"log:frontend": "docker compose -p mug logs -f --no-log-prefix frontend",
		"log:db": "docker compose -p mug logs -f db",
		"log:minio": "docker compose -p mug logs -f minio",
		"log:all": "docker compose -p mug logs -f"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.49.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.17",
		"@types/bun": "^1.3.4",
		"concurrently": "^9.2.1",
		"drizzle-kit": "^0.31.8",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.45.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"typescript": "^5.9.3",
		"vite": "^7.2.7"
	},
	"dependencies": {
		"@libsql/client": "^0.15.15",
		"@orpc/client": "^1.12.2",
		"@orpc/server": "^1.12.2",
		"@pixi/sound": "^6.0.1",
		"@types/uuid": "^11.0.0",
		"arktype": "^2.1.28",
		"better-auth": "^1.4.6",
		"drizzle-arktype": "^0.1.3",
		"drizzle-orm": "^0.45.1",
		"gsap": "^3.14.1",
		"jszip": "^3.10.1",
		"partykit": "^0.0.115",
		"partysocket": "^1.1.6",
		"pg": "^8.16.3",
		"pixi.js": "^8.14.3",
		"postgres": "^3.4.7",
		"tweakpane": "^4.0.5",
		"uuid": "^13.0.0"
	}
}

{
	"name": "mug-monorepo",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:services": "bun run scripts/dev.ts",
		"db:push": "bunx drizzle-kit push",
		"db:studio": "bunx drizzle-kit studio",
		"format:biome": "biome format --write .",
		"format": "prettier --write .",
		"lint:biome": "biome lint",
		"lint": "prettier --check .",
		"docker:up": "docker compose up -d",
		"docker:up-no-frontend": "docker compose up -d db minio minio-init",
		"docker:down": "docker compose down",
		"docker:destroy": "docker compose down -v",
		"docker:rebuild": "docker compose down -v && docker compose up -d --build",
		"docker:restart-frontend": "docker compose -p mug restart frontend",
		"auth:generate": "bunx --bun  @better-auth/cli generate  --config ./src/lib/server/auth.ts  --output ./src/lib/server/db/auth-schema.ts -y"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.8",
		"@types/bun": "^1.3.4",
		"drizzle-kit": "^0.31.8",
		"prettier": "^3.7.4",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte-adapter-bun": "^1.0.1"
	},
	"dependencies": {
		"drizzle-orm": "0.45.1"
	}
}
